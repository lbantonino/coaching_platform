# Variables d'environnement : copier ce fichier vers .env.local, puis remplir.

# Supabase, accessibles au navigateur (les données restent protégées par la RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase, clé secrète : serveur uniquement
SUPABASE_SECRET_KEY=

# Connexions sociales activées, séparées par des virgules (google, facebook, apple)
AUTH_PROVIDERS=

# Clé de l'API Claude pour l'assistant IA : serveur uniquement
ANTHROPIC_API_KEY=
