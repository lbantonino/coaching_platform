# Variables d'environnement : copier ce fichier vers .env.local, puis remplir.

# Supabase, accessibles au navigateur (les données restent protégées par la RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase, clé secrète : serveur uniquement
SUPABASE_SECRET_KEY=

# Connexions sociales activées, séparées par des virgules (google, facebook, apple)
AUTH_PROVIDERS=

# Clé de l'API Claude pour l'assistant IA : serveur uniquement
ANTHROPIC_API_KEY=

# Alertes des séances sur le téléphone (D-205) : clés VAPID (npx web-push generate-vapid-keys),
# adresse de contact du service (URL de Coory) et secret de la route /api/alertes (le même dans le
# Vault de Supabase, nom alertes_secret). Serveur uniquement, sauf la clé publique.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
ALERTES_SECRET=
